# API keys
NEXT_PUBLIC_ENVIRONMENT_ID=your-dynamic-env-id
ETHERSCAN_API_KEY=your-etherscan-api-key
# Server-only; injected by the /api/relay proxy. Never prefix with NEXT_PUBLIC_.
RELAY_API_KEY=your-relay-api-key
# Server-only archive RPCs (full Eclipse history) for /api/withdrawal-tx.
# Never prefix with NEXT_PUBLIC_: the URLs can carry access tokens.
ECLIPSE_ARCHIVE_RPC_MAINNET=your-eclipse-mainnet-archive-rpc-url
ECLIPSE_ARCHIVE_RPC_TESTNET=your-eclipse-testnet-archive-rpc-url

# Website metadata
WEBSITE_TITLE="Bridge to Eclipse"
WEBSITE_DESCRIPTION="Official Eclipse Bridge."

# App configuration
NEXT_PUBLIC_ECLIPSE_RPC=https://mainnetbeta-rpc.eclipse.xyz
NEXT_PUBLIC_CURRENT_CHAIN=mainnet
